# moe-phone patch for github.com/Helldez/BigMoeOnEdge @ 74ba18f (+ its llama.cpp fork), applied AFTER 0002-0009.
# --expert-resident-first: compute a layer's ALREADY-RESIDENT experts before the ones still being read.
#
# WHY. gates/decode_budget.py splits the best measured cell (results/2026-09-17/bmoe_cache.json,
# ceil5000) into 93.0 ms compute residual + 20.0 ms cache management + 48.3 ms stall per token, and that
# stall is almost exactly the whole of the cell's miss traffic (119.8 MiB/token at the measured ~2.8 GB/s
# aggregate flash bandwidth = ~43 ms), i.e. essentially NONE of it is hidden by --overlap. The reason is
# in ggml: mul_mat_id consumes a layer's selected experts in ascending expert id and the expert-ready
# hook blocks on each in turn, so a layer waits on its lowest-id miss while its other seven experts --
# already in memory, ~2.4 ms of compute -- sit unused behind it.
#
# WHAT IT CHANGES. A non-blocking residency probe hook, and a two-pass loop in mul_mat_id: pass 0 takes
# the experts the probe reports resident, pass 1 the rest. Threads may order them differently and the
# result is still exact -- every thread visits every selected expert exactly once and each expert's
# chunks are claimed from its own atomic counter -- so no shared publication and no extra work buffer is
# needed. The ready hook still blocks before any expert's bytes are read, so a stale probe cannot make
# the result wrong: a false negative costs only ordering, a false positive is caught by the hook.
# Lossless by construction, and checked: identical generated text at temp 0 (laptop, Qwen3-30B-A3B).
# ===== fork (third_party/llama.cpp) =====
diff --git a/ggml/include/ggml-cpu.h b/ggml/include/ggml-cpu.h
--- a/ggml/include/ggml-cpu.h
+++ b/ggml/include/ggml-cpu.h
@@ -155,6 +155,15 @@
     typedef const char * (*ggml_cpu_expert_data_hook_t)(const struct ggml_tensor * src0, int expert, void * user_data);
     GGML_BACKEND_API void ggml_cpu_set_expert_data_hook(ggml_cpu_expert_data_hook_t hook, void * user_data);
 
+    // moe-phone: non-blocking residency query. mul_mat_id consumes a layer's selected experts in
+    // ASCENDING EXPERT ID, and the ready hook blocks on each in turn, so one expert still in flight
+    // stalls the layer even when every other selected expert is already in memory. With this hook set,
+    // each thread computes the experts this returns true for FIRST and the rest afterwards, which gives
+    // the reads still in flight the resident experts' compute time to land. It must not block, and it is
+    // allowed to be wrong in either direction: a false negative only costs ordering, and a false
+    // positive is caught by the ready hook, which still blocks before any bytes are read.
+    typedef bool (*ggml_cpu_expert_probe_hook_t)(const struct ggml_tensor * src0, int expert, void * user_data);
+    GGML_BACKEND_API void ggml_cpu_set_expert_probe_hook(ggml_cpu_expert_probe_hook_t hook, void * user_data);
 
     // moe-phone: repacked (interleaved, i8mm/dotprod/AVX2) kernels for expert tensors whose data an
     // external engine streams in. bind tags the tensor for the repacked MUL_MAT_ID kernel (false if
diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -71,6 +71,18 @@
     g_expert_ready_hook_data = user_data;
 }
 
+static ggml_cpu_expert_probe_hook_t g_expert_probe_hook      = NULL; // moe-phone
+static void *                       g_expert_probe_hook_data = NULL;
+void ggml_cpu_set_expert_probe_hook(ggml_cpu_expert_probe_hook_t hook, void * user_data) {
+    g_expert_probe_hook      = hook;
+    g_expert_probe_hook_data = user_data;
+}
+
+// moe-phone: the largest expert count this reordering supports without heap allocation. Every model
+// measured here is far below it (Qwen3-30B-A3B has 128, OLMoE 64); above it the kernel keeps the
+// original ascending order, which is always correct.
+#define GGML_MMID_MAX_REORDER_EXPERTS 512
+
 // moe-phone: the repacked MUL_MAT_ID kernel (repack.cpp) calls this at the same point the generic
 // kernel calls the hook, so an overlapping streaming engine still gets to block until the expert
 // has landed before its bytes are read.
@@ -1670,6 +1682,18 @@
 
     ggml_barrier(params->threadpool);
 
+    // moe-phone: two passes over the selected experts when a residency probe is installed -- pass 0
+    // takes the ones already in memory, pass 1 the remainder. Each THREAD may order the experts
+    // differently and the result is still exact: every thread visits every selected expert exactly once,
+    // and each expert's chunks are claimed from its own atomic counter, so no chunk is computed twice or
+    // skipped. `done` records what pass 0 took, because an expert can become resident between the
+    // passes and must not then be computed again.
+    const bool reorder = g_expert_probe_hook && n_as <= GGML_MMID_MAX_REORDER_EXPERTS;
+    unsigned char done[GGML_MMID_MAX_REORDER_EXPERTS];
+    if (reorder) {
+        memset(done, 0, (size_t) n_as);
+    }
+    for (int pass = 0; pass < (reorder ? 2 : 1); ++pass) {
     for (int cur_a = 0; cur_a < n_as; ++cur_a) {
         const int64_t cne1 = matrix_row_counts[cur_a];
 
@@ -1677,6 +1701,17 @@
             continue;
         }
 
+        if (reorder) {
+            if (pass == 0) {
+                if (!g_expert_probe_hook(src0, cur_a, g_expert_probe_hook_data)) {
+                    continue; // still in flight: come back to it in pass 1
+                }
+                done[cur_a] = 1;
+            } else if (done[cur_a]) {
+                continue; // already computed in pass 0
+            }
+        }
+
         // Signal an external expert-streaming engine that this expert is about to be
         // consumed; the hook may block until src0's expert weights are resident.
         if (g_expert_ready_hook) {
@@ -1740,6 +1775,7 @@
             current_chunk = atomic_fetch_add_explicit(current_chunk_ctr, 1, memory_order_relaxed);
         }
     }
+    } // moe-phone: end of the resident-first pass loop
 }
 
