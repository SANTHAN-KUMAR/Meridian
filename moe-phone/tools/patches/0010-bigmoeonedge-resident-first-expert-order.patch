 // Called from EVERY compute thread, for each routed expert, before it reads that expert's rows.
 // Blocks until the expert's slice for the layer in flight is resident (or the run goes fatal).
+bool ExpertStreamSource::c_expert_probe(const ggml_tensor * src0, int expert, void * user_data) {
+    return static_cast<ExpertStreamSource *>(user_data)->expert_resident(src0, expert);
+}
+
+bool ExpertStreamSource::expert_resident(const ggml_tensor * src0, int expert) const {
+    const void * key = (const void *) src0;
+    auto it = std::lower_bound(texp_.begin(), texp_.end(), key,
+                               [](const std::pair<const void *, uint32_t> & a, const void * k) { return a.first < k; });
+    if (it == texp_.end() || it->first != key) return true; // not ours: never reorder around it
+    const uint32_t packed = it->second;
+    const int il = (int) (packed >> 8);
+    const int p = (int) (packed & 0xff);
+    // A layer mismatch is on_expert_ready's fail-fast path, so claim residency and let it handle it
+    // rather than silently reordering a graph we did not stage.
+    if (il != cur_il_.load(std::memory_order_relaxed) || expert < 0 || expert >= n_expert_) return true;
+    const size_t idx = (size_t) p * (size_t) n_expert_ + (size_t) expert;
+    return ready_[idx].gen.load(std::memory_order_acquire) == async_gen_.load(std::memory_order_relaxed);
+}
