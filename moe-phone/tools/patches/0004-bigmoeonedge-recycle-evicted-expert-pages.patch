@@ -957,6 +971,42 @@ bool ExpertStreamSource::commit_proj_pages(int il, int e, int p) {
     const uint64_t slice = L.proj[p].nb2;
     if (slice == 0) return true; // absent slot in a fused layout
     char * dst = (char *) lbuf_[p][il] + (uint64_t) e * slice;
+#if defined(__linux__)
+    if (recycle_pages_) {
+        const int32_t did = il * n_expert_ + e;
+        auto it = recycle_free_.find(slice);
+        if (parked_bits_[(size_t) did] & (1u << p)) {
+            // This very slot is parked: its pages are still mapped here. Unpark and reuse in place.
+            auto & v = recycle_free_[slice];
+            for (size_t i = 0; i < v.size(); ++i)
+                if (v[i].first == did && v[i].second == p) { v[i] = v.back(); v.pop_back(); break; }
+            parked_bits_[(size_t) did] &= (uint8_t) ~(1u << p);
+            --recycle_free_n_;
+            ++recycle_inplace_;
+            return true;
+        }
+        if (it != recycle_free_.end() && !it->second.empty() && ((uintptr_t) dst % page_) == 0) {
+            const auto sp = it->second.back();
+            it->second.pop_back();
+            --recycle_free_n_;
+            parked_bits_[(size_t) sp.first] &= (uint8_t) ~(1u << sp.second);
+            const uintptr_t src = (uintptr_t) lbuf_[sp.second][sp.first / n_expert_] + (uintptr_t) (sp.first % n_expert_) * slice;
+            // Move the parked physical pages under the missing slot (no zero-fill, no first-touch
+            // faults: the reads overwrite every byte), then re-reserve the hole the move left so the
+            // evicted expert's slot stays addressable for its own later miss.
+            void * m = mremap((void *) src, slice, slice, MREMAP_MAYMOVE | MREMAP_FIXED, dst);
+            void * r = m == MAP_FAILED ? MAP_FAILED
+                     : mmap((void *) src, slice, PROT_READ | PROT_WRITE,
+                            MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE | MAP_FIXED, -1, 0);
+            if (m == dst && r == (void *) src) { ++recycle_moved_; return true; }
+            ++recycle_errors_;
+            std::fprintf(stderr, "bmoe: recycle-pages: mremap/mmap failed (%s) at layer %d expert %d proj %d\n",
+                         std::strerror(errno), il, e, p);
+            return false; // the reservation may now have a hole: never compute over it
+        }
+        ++recycle_fresh_;
+    }
+#endif
     uintptr_t a0 = (uintptr_t) dst & ~(uintptr_t) (page_ - 1);
     uintptr_t a1 = ((uintptr_t) dst + slice + page_ - 1) & ~(uintptr_t) (page_ - 1);
     if (!pio::vm_commit((void *) a0, (size_t) (a1 - a0))) {
@@ -1451,6 +1501,9 @@ IExpertSource::Stats ExpertStreamSource::stats() const {
 }
 
 void ExpertStreamSource::shutdown() {
+    if (recycle_pages_)
+        std::fprintf(stderr, "bmoe: recycle-pages: moved %lld in-place %lld fresh %lld released %lld errors %lld\n",
+                     recycle_moved_, recycle_inplace_, recycle_fresh_, recycle_released_, recycle_errors_);
     if (!active_) return;
 #ifdef BMOE_HAVE_EXPERT_READY_HOOK
     // Unregister the process-global hook FIRST: after this no compute thread can enter
