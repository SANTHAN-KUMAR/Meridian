     if (recycle_pages_)
         std::fprintf(stderr, "bmoe: recycle-pages: moved %lld in-place %lld fresh %lld released %lld errors %lld\n",
                      recycle_moved_, recycle_inplace_, recycle_fresh_, recycle_released_, recycle_errors_);
