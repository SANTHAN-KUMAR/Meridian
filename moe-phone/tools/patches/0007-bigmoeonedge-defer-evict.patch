     char * dst = (char *) lbuf_[p][il] + (uint64_t) e * slice;
+    if (defer_evict_) {
+        const int32_t cid = il * n_expert_ + e;
+        if (deferred_bits_[(size_t) cid] & (1u << p)) {
+            // queued for release but needed again: cancel, so the flush cannot wipe the new read
+            deferred_bits_[(size_t) cid] &= (uint8_t) ~(1u << p);
+            for (size_t i = 0; i < deferred_.size(); ++i)
+                if (deferred_[i].first == cid && deferred_[i].second == p) { deferred_[i] = deferred_.back(); deferred_.pop_back(); break; }
+            ++deferred_cancelled_;
+        }
+    }
 #if defined(__linux__)
     if (recycle_pages_) {
         const int32_t did = il * n_expert_ + e;
@@ -1501,6 +1537,8 @@ IExpertSource::Stats ExpertStreamSource::stats() const {
 }
 
