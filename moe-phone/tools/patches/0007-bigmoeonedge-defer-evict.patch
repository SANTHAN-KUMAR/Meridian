--- a/core/include/bmoe/config.h
+++ b/core/include/bmoe/config.h
@@ -71,6 +71,12 @@ struct MoeStreamConfig {
     // otherwise the engine falls back per slice and counts it.
     bool recycle_pages = false;
 
+    // moe-phone: queue evicted slices' MADV_DONTNEED and run them in one batch after each decode returns
+    // (flush_deferred_evictions), so the TLB-shootdown IPIs land on idle compute cores instead of
+    // interrupting a running graph. The entry is invalid immediately; only the page release is deferred,
+    // and a re-commit of a queued slice cancels its release. Billed inside the decode's wall time.
+    bool defer_evict = false;
+
     bool o_direct = true;     // bypass the page cache (O_DIRECT / FILE_FLAG_NO_BUFFERING)
