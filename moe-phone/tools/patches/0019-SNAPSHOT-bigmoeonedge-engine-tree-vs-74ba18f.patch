@@ -0,0 +1,377 @@
+// gpu_tier.cpp — moe-phone (patch 0019): backends for the GPU expert tier. See gpu_tier.h.
+//
+// Bit-identity argument for CpuExpertFfn (checked end to end by the engine's text-identity acceptance, design §12):
+//   - gate/up/down rows: ggml-cpu's MUL_MAT_ID computes each output row as ONE vec_dot call (nrc = 1) of the
+//     weight row against the activation row quantized by from_float into the type's vec_dot_type
+//     (ggml-cpu.c, ggml_compute_forward_mul_mat_id_one_chunk). The same calls are made here, with the same
+//     quantization of the same fp32 input. The M1 test (host/test_mmid_split.cpp) showed this reproduces
+//     MUL_MAT_ID's rows bit for bit.
+//   - SwiGLU: the graph computes ggml_swiglu_split(gate, up) row by row; the same op, on one row, is run here
+//     through a one-op ggml graph, so the element function is ggml's own.
+//   - down: its input row (the SwiGLU output) is quantized into the down type's vec_dot_type exactly as
+//     MUL_MAT_ID quantizes src1 per slot, then one vec_dot per output row.
+// Nothing here calls MUL_MAT_ID, so the split hooks never recurse.
+#include "gpu_tier.h"
+
+#include "ggml-cpu.h"
+
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <thread>
+
+#ifdef BMOE_HAVE_GX
+#include "gx.h"
+#endif
+
+namespace bmoe {
+
+// ── CpuExpertFfn ─────────────────────────────────────────────────────────────────────────────────────────────
+CpuExpertFfn::~CpuExpertFfn() {
+    if (ctx_) ggml_free(ctx_);
+}
+
+bool CpuExpertFfn::init(int n_embd, int n_ff) {
+    n_embd_ = n_embd;
+    n_ff_ = n_ff;
+    ggml_init_params ip = { (size_t) 4 * 1024 * 1024, nullptr, false };
+    ctx_ = ggml_init(ip);
+    if (!ctx_) return false;
+    g_ = ggml_new_tensor_1d(ctx_, GGML_TYPE_F32, n_ff);
+    u_ = ggml_new_tensor_1d(ctx_, GGML_TYPE_F32, n_ff);
+    h_ = ggml_swiglu_split(ctx_, g_, u_);
+    gf_ = ggml_new_graph(ctx_);
+    ggml_build_forward_expand(gf_, h_);
+    gate_.resize((size_t) n_ff);
+    up_.resize((size_t) n_ff);
+    return true;
+}
+
+// rows[r] = vec_dot(weight row r, quantized input) for r in [0, n_rows): what MUL_MAT_ID's one_chunk computes.
+static void rows_dot(ggml_type wt, const void * w, int64_t n_in, int64_t n_rows, const float * in, float * out,
+                     std::vector<char> & q) {
+    const auto * tr = ggml_get_type_traits_cpu(wt);
+    const ggml_type vt = tr->vec_dot_type;
+    const auto * trv = ggml_get_type_traits_cpu(vt);
+    const size_t row_bytes = ggml_row_size(wt, n_in);
+    const void * y = in;
+    if (vt != GGML_TYPE_F32) {
+        q.resize(ggml_row_size(vt, n_in));
+        trv->from_float(in, q.data(), n_in);
+        y = q.data();
+    }
+    for (int64_t r = 0; r < n_rows; ++r)
+        tr->vec_dot((int) n_in, &out[r], 0, (const char *) w + (size_t) r * row_bytes, 0, y, 0, 1);
+}
+
+bool CpuExpertFfn::run(ggml_type tg, ggml_type tu, ggml_type td, const void * wg, const void * wu, const void * wd,
+                       const float * x, float * out) {
+    rows_dot(tg, wg, n_embd_, n_ff_, x, gate_.data(), q_);
+    rows_dot(tu, wu, n_embd_, n_ff_, x, up_.data(), q_);
+    std::memcpy(g_->data, gate_.data(), (size_t) n_ff_ * sizeof(float));
+    std::memcpy(u_->data, up_.data(), (size_t) n_ff_ * sizeof(float));
+    if (ggml_graph_compute_with_ctx(ctx_, gf_, 1) != GGML_STATUS_SUCCESS) return false;
+    rows_dot(td, wd, n_ff_, n_embd_, (const float *) h_->data, out, q_);
+    return true;
+}
+
+bool GpuExpertsBackend::write_expert(int slot, const void * const src[3], const size_t bytes[3], ggml_type t_down) {
+    (void) t_down;
+    char * base = (char *) map_write(slot);
+    if (!base) return false;
+    for (int p = 0; p < 3; ++p) std::memcpy(base + slice_offset(slot, p), src[p], bytes[p]);
+    unmap(slot, base);
+    return true;
+}
+
+namespace {
+
+// ── standin: the "device" is a CPU thread running CpuExpertFfn ─────────────────────────────────────────────────
+class StandinBackend final : public GpuExpertsBackend {
+public:
+    ~StandinBackend() override {
+        {
+            std::lock_guard<std::mutex> lk(mtx_);
+            stop_ = true;
+        }
+        cv_.notify_all();
+        if (worker_.joinable()) worker_.join();
+        for (void * p : slots_) std::free(p);
+    }
+    const char * name() const override { return "standin"; }
+
+    int init(const GpuTierShape & shape, int max_slots) override {
+        shape_ = shape;
+        slot_bytes_ = 0;
+        for (int p = 0; p < 3; ++p) {
+            off_[p] = slot_bytes_;
+            slot_bytes_ += (shape.slice_bytes[p] + 4095) & ~(size_t) 4095;
+        }
+        for (int s = 0; s < max_slots; ++s) {
+            void * m = nullptr;
+            if (posix_memalign(&m, 4096, slot_bytes_) != 0 || !m) break;
+            slots_.push_back(m);
+        }
+        if (!ffn_.init(shape.n_embd, shape.n_ff)) return 0;
+        worker_ = std::thread([this] { run(); });
+        return (int) slots_.size();
+    }
+
+    void * map_write(int slot) override { return slots_[(size_t) slot]; }
+    void unmap(int, void *) override {}
+    const void * map_read(int slot) override { return slots_[(size_t) slot]; }
+    void unmap_read(int, const void *) override {}
+    size_t slice_offset(int, int p) const override { return off_[p]; }
+
+    bool dispatch(int layer, ggml_type tg, ggml_type tu, ggml_type td, int k, const int * slots, const float * x,
+                  float * out) override {
+        std::lock_guard<std::mutex> lk(mtx_);
+        if (busy_) return false; // one dispatch in flight at a time
+        job_.layer = layer;
+        job_.t[0] = tg; job_.t[1] = tu; job_.t[2] = td;
+        job_.slots.assign(slots, slots + k);
+        job_.x.assign(x, x + shape_.n_embd);
+        job_.out = out;
+        job_.ok = true;
+        busy_ = true;
+        cv_.notify_all();
+        return true;
+    }
+
+    bool wait() override {
+        std::unique_lock<std::mutex> lk(mtx_);
+        done_cv_.wait(lk, [&] { return !busy_; });
+        return job_.ok;
+    }
+
+private:
+    struct Job {
+        int layer = -1;
+        ggml_type t[3];
+        std::vector<int> slots;
+        std::vector<float> x;
+        float * out = nullptr;
+        bool ok = true;
+    };
+
+    void run() {
+        for (;;) {
+            {
+                std::unique_lock<std::mutex> lk(mtx_);
+                cv_.wait(lk, [&] { return stop_ || (busy_ && !running_); });
+                if (stop_) return;
+                running_ = true;
+            }
+            for (size_t i = 0; i < job_.slots.size(); ++i) {
+                const char * base = (const char *) slots_[(size_t) job_.slots[i]];
+                if (!ffn_.run(job_.t[0], job_.t[1], job_.t[2], base + off_[0], base + off_[1], base + off_[2],
+                              job_.x.data(), job_.out + i * (size_t) shape_.n_embd)) {
+                    job_.ok = false;
+                    break;
+                }
+            }
+            {
+                std::lock_guard<std::mutex> lk(mtx_);
+                running_ = false;
+                busy_ = false;
+            }
+            done_cv_.notify_all();
+        }
+    }
+
+    GpuTierShape shape_;
+    size_t off_[3] = {0, 0, 0};
+    size_t slot_bytes_ = 0;
+    std::vector<void *> slots_;
+    CpuExpertFfn ffn_;
+    std::mutex mtx_;
+    std::condition_variable cv_, done_cv_;
+    bool stop_ = false, busy_ = false, running_ = false;
+    Job job_;
+    std::thread worker_;
+};
+
+#ifdef BMOE_HAVE_GX
+// ── gx: libgx on the device's OpenCL GPU ────────────────────────────────────────────────────────────────────────
+class GxBackend final : public GpuExpertsBackend {
+public:
+    GxBackend(int variant, int spin) : variant_(variant), spin_(spin) {}
+    ~GxBackend() override {
+        if (g_) {
+            for (const gx_slot & s : slots_) gx_slot_free(g_, &s);
+            gx_free(g_);
+        }
+        // the cl_context lives for the process (one per run) and is reclaimed at exit; gx's cl_shim does not forward
+        // clReleaseContext, so it is not released here
+    }
+    const char * name() const override { return "gx"; }
+
+    bool open(std::string * err) {
+        cl_platform_id plats[8];
+        cl_uint np = 0;
+        if (clGetPlatformIDs(8, plats, &np) != CL_SUCCESS || np == 0) { if (err) *err = "no OpenCL platform"; return false; }
+        for (cl_uint i = 0; i < np && !dev_; ++i) {
+            cl_uint nd = 0;
+            if (clGetDeviceIDs(plats[i], CL_DEVICE_TYPE_GPU, 1, &dev_, &nd) != CL_SUCCESS || nd == 0) dev_ = nullptr;
+        }
+        if (!dev_) { if (err) *err = "no OpenCL GPU device"; return false; }
+        cl_int e = 0;
+        ctx_ = clCreateContext(nullptr, 1, &dev_, nullptr, nullptr, &e);
+        if (!ctx_ || e != CL_SUCCESS) { if (err) *err = "clCreateContext failed"; return false; }
+        return true;
+    }
+
+    int init(const GpuTierShape & shape, int max_slots) override {
+        shape_ = shape;
+        gx_params p{};
+        p.n_embd = shape.n_embd;
+        p.n_ff = shape.n_ff;
+        p.debug_h = 0;
+        p.variant = variant_;
+        p.profile = 1;
+        p.spin_wait = spin_;
+        char err[512] = {0};
+        g_ = gx_init(ctx_, dev_, p, err, sizeof(err));
+        if (!g_) { std::fprintf(stderr, "bmoe: gpu-tier gx: gx_init failed: %s\n", err); return 0; }
+        // one expert per cl_mem (the teammate's recommendation: kernels never read a buffer with a mapped region)
+        size_t slot_bytes = 0;
+        for (int q = 0; q < 3; ++q) slot_bytes += (shape.slice_bytes[q] + 4095) & ~(size_t) 4095;
+        const int nb = gx_pool_create(g_, slot_bytes, max_slots, err, sizeof(err));
+        std::fprintf(stderr, "bmoe: gpu-tier gx: pool %d/%d blocks of %zu KiB (%s)\n", nb, max_slots, slot_bytes >> 10, err);
+        if (nb <= 0) return 0;
+        for (int i = 0; i < nb; ++i) {
+            gx_slot s{};
+            if (!gx_slot_alloc(g_, shape.slice_bytes[0], shape.slice_bytes[1], shape.slice_bytes[2], &s)) break;
+            slots_.push_back(s);
+        }
+        return (int) slots_.size();
+    }
+
+    void * map_write(int slot) override { return gx_slot_map_write(g_, &slots_[(size_t) slot]); }
+    void unmap(int slot, void * base) override {
+        if (gx_slot_unmap(g_, &slots_[(size_t) slot], base) != 0) ++map_errors_;
+    }
+    const void * map_read(int slot) override { return gx_slot_map_read(g_, &slots_[(size_t) slot]); }
+    void unmap_read(int slot, const void * base) override {
+        if (gx_slot_unmap_read(g_, &slots_[(size_t) slot], base) != 0) ++map_errors_;
+    }
+    // Repacking variants (per gx_variant_uses_repack: 2 = [ib][row] planes, 3 = tiled by 64-row groups; same
+    // bytes permuted, same offsets): writes go through gx_repack_expert and the CPU paths read through
+    // gx_unpack_expert, its exact inverse; gx picks the layout from the context's variant.
+    bool repacked() const { return gx_variant_uses_repack(variant_) != 0; } // libgx decides which layouts repack (v2, v3; v4 is native)
+    bool native_layout() const override { return !repacked(); }
+    bool write_expert(int slot, const void * const src[3], const size_t bytes[3], ggml_type t_down) override {
+        if (!repacked()) return GpuExpertsBackend::write_expert(slot, src, bytes, t_down);
+        const gx_slot & s = slots_[(size_t) slot];
+        void * base = gx_slot_map_write(g_, &s);
+        if (!base) return false;
+        const int rc = gx_repack_expert(g_, &s, base, src[0], src[1], src[2], gx_down(t_down));
+        const long long me = map_errors_;
+        unmap(slot, base);
+        return rc == 0 && map_errors_ == me;
+    }
+    bool read_expert(int slot, void * const dst[3], ggml_type t_down) override {
+        if (!repacked()) return false;
+        const gx_slot & s = slots_[(size_t) slot];
+        const void * base = gx_slot_map_read(g_, &s);
+        if (!base) return false;
+        const int rc = gx_unpack_expert(g_, &s, base, dst[0], dst[1], dst[2], gx_down(t_down));
+        const long long me = map_errors_;
+        unmap_read(slot, base);
+        return rc == 0 && map_errors_ == me;
+    }
+    static int gx_down(ggml_type t) { return t == GGML_TYPE_Q4_1 ? GX_DOWN_Q4_1 : GX_DOWN_Q4_0; }
+
+    size_t slice_offset(int slot, int p) const override {
+        const gx_slot & s = slots_[(size_t) slot];
+        return (p == 0 ? s.off_gate : p == 1 ? s.off_up : s.off_down) - s.off_gate;
+    }
+
+    bool dispatch(int layer, ggml_type tg, ggml_type tu, ggml_type td, int k, const int * slots, const float * x,
+                  float * out) override {
+        if (tg != GGML_TYPE_Q4_0 || tu != GGML_TYPE_Q4_0 || (td != GGML_TYPE_Q4_0 && td != GGML_TYPE_Q4_1)) return false;
+        if (k <= 0 || k > GX_MAX_K) return false;
+        gx_slot ss[GX_MAX_K];
+        for (int i = 0; i < k; ++i) ss[i] = slots_[(size_t) slots[i]];
+        return gx_dispatch(g_, layer, td == GGML_TYPE_Q4_1 ? GX_DOWN_Q4_1 : GX_DOWN_Q4_0, k, ss, x, out) == 0;
+    }
+    bool wait() override {
+        const bool ok = gx_wait(g_) == 0;
+        risk_ = ok ? gx_last_risk_mask(g_) : 0;
+        uint64_t dn = 0, hn = 0;
+        dev_ns_ = (ok && gx_last_timing(g_, &dn, &hn) == 0) ? dn : 0;
+        return ok;
+    }
+    uint32_t last_risk_mask() const override { return risk_; }
+    uint64_t last_device_ns() const override { return dev_ns_; }
+    long long map_errors() const override { return map_errors_; }
+
+private:
+    int variant_ = 1;
+    int spin_ = 0;
+    cl_device_id dev_ = nullptr;
+    cl_context ctx_ = nullptr;
+    gx_ctx * g_ = nullptr;
+    GpuTierShape shape_;
+    std::vector<gx_slot> slots_;
+    uint32_t risk_ = 0;
+    uint64_t dev_ns_ = 0;
+    long long map_errors_ = 0;
+};
+#endif
+
+} // namespace
+
+std::unique_ptr<GpuExpertsBackend> make_gpu_backend_standin() { return std::make_unique<StandinBackend>(); }
+
+void * gpu_pinned_alloc(size_t bytes, std::string * err) {
+#ifdef BMOE_HAVE_GX
+    // one context and queue for the process (the blocks live until exit; the driver reclaims them)
+    static std::mutex mu;
+    static cl_context ctx = nullptr;
+    static cl_command_queue q = nullptr;
+    std::lock_guard<std::mutex> lk(mu);
+    cl_int e = CL_SUCCESS;
+    if (!ctx) {
+        cl_platform_id plats[8];
+        cl_uint np = 0;
+        cl_device_id dev = nullptr;
+        if (clGetPlatformIDs(8, plats, &np) != CL_SUCCESS || np == 0) { if (err) *err = "no OpenCL platform"; return nullptr; }
+        for (cl_uint i = 0; i < np && !dev; ++i) {
+            cl_uint nd = 0;
+            if (clGetDeviceIDs(plats[i], CL_DEVICE_TYPE_GPU, 1, &dev, &nd) != CL_SUCCESS || nd == 0) dev = nullptr;
+        }
+        if (!dev) { if (err) *err = "no OpenCL GPU device"; return nullptr; }
+        ctx = clCreateContext(nullptr, 1, &dev, nullptr, nullptr, &e);
+        if (!ctx || e != CL_SUCCESS) { ctx = nullptr; if (err) *err = "clCreateContext failed"; return nullptr; }
+        q = clCreateCommandQueue(ctx, dev, 0, &e);
+        if (!q || e != CL_SUCCESS) { q = nullptr; if (err) *err = "clCreateCommandQueue failed"; return nullptr; }
+    }
+    if (!q) { if (err) *err = "no command queue"; return nullptr; }
+    cl_mem m = clCreateBuffer(ctx, CL_MEM_ALLOC_HOST_PTR | CL_MEM_READ_WRITE, bytes, nullptr, &e);
+    if (!m || e != CL_SUCCESS) { if (err) *err = "clCreateBuffer failed (" + std::to_string(e) + ")"; return nullptr; }
+    void * p = clEnqueueMapBuffer(q, m, CL_TRUE, CL_MAP_READ | CL_MAP_WRITE, 0, bytes, 0, nullptr, nullptr, &e);
+    if (!p || e != CL_SUCCESS) { if (err) *err = "clEnqueueMapBuffer failed (" + std::to_string(e) + ")"; return nullptr; }
+    return p;
+#else
+    (void) bytes;
+    if (err) *err = "this build has no OpenCL (configure with BMOE_GX_SRC)";
+    return nullptr;
+#endif
+}
+
+std::unique_ptr<GpuExpertsBackend> make_gpu_backend_gx(int variant, std::string * err, int spin_wait) {
+#ifdef BMOE_HAVE_GX
+    auto b = std::make_unique<GxBackend>(variant, spin_wait);
+    if (!b->open(err)) return nullptr;
+    return b;
+#else
+    (void) variant; (void) spin_wait;
+    if (err) *err = "this build has no libgx (configure with BMOE_GX_SRC)";
+    return nullptr;
+#endif
+}
+
