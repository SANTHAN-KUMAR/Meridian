@@ -0,0 +1,96 @@
+// gpu_tier.h — moe-phone (patch 0019): the device side of the GPU expert tier.
+//
+// The engine keeps two tiers of expert residency (moe-phone research/2026-09-18_gpu_expert_path_design.md §12):
+// the CPU tier (the anon LRU/SLRU cache) and this GPU tier, a pool of slots each holding ONE expert's three
+// slices (gate, up, down). An expert lives in exactly one tier. At decode (one token), every selected expert the
+// GPU tier owns (up to a per-layer cap) is computed by the device -- its whole FFN, gate, up, SwiGLU, down -- in
+// one dispatch per layer, concurrently with the CPU's MUL_MAT_ID over the rest (ggml-cpu split hooks, 0017).
+//
+// Backends:
+//   standin  CPU implementation on its own thread, bit-identical to ggml-cpu's MUL_MAT_ID + swiglu_split rows by
+//            construction (type-traits from_float + vec_dot per row, as mul_mat_id's one_chunk; SwiGLU through a
+//            one-op ggml graph). Lets the whole engine be checked for byte-identical text on a laptop.
+//   gx       libgx (moe-phone/host/gpu_ffn, component C): OpenCL on the phone's Adreno, bit-matched to ggml-cpu's
+//            ARM path; built only with BMOE_HAVE_GX. Slots flagged by gx's risk detector (denormal-range values the
+//            device may flush) are recomputed on the CPU with CpuExpertFfn, exactly, and counted.
+// Coherence contract (the only protocol verified on the phone): a slot is written only between map_write() and
+// unmap(); dispatch() never reads a slot that is mapped; a slot may be read-mapped while a dispatch reads OTHER slots.
+#pragma once
+
+#include "ggml.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace bmoe {
+
+struct GpuTierShape {
+    int n_embd = 0;          // expert input / down output width
+    int n_ff = 0;            // expert hidden width
+    size_t slice_bytes[3];   // largest gate, up, down slice across layers (slots are sized for the largest)
+};
+
+// One expert's FFN on the CPU with ggml-cpu's own arithmetic: out = down(swiglu(gate(x), up(x))). Bit-identical to
+// the MUL_MAT_ID + swiglu_split rows the graph would compute for this expert (see gpu_tier.cpp).
+class CpuExpertFfn {
+public:
+    ~CpuExpertFfn();
+    bool init(int n_embd, int n_ff);
+    bool run(ggml_type tg, ggml_type tu, ggml_type td, const void * wg, const void * wu, const void * wd,
+             const float * x, float * out);
+private:
+    int n_embd_ = 0, n_ff_ = 0;
+    ggml_context * ctx_ = nullptr;
+    ggml_tensor * g_ = nullptr, * u_ = nullptr, * h_ = nullptr;
+    ggml_cgraph * gf_ = nullptr;
+    std::vector<char> q_;
+    std::vector<float> gate_, up_;
+};
+
+class GpuExpertsBackend {
+public:
+    virtual ~GpuExpertsBackend() = default;
+    virtual const char * name() const = 0;
+    // Allocate up to `max_slots` slots; returns how many were actually allocated (0 = unusable).
+    virtual int init(const GpuTierShape & shape, int max_slots) = 0;
+    // Whole-slot access; projection p (0 gate, 1 up, 2 down) is at base + slice_offset(slot, p).
+    virtual void * map_write(int slot) = 0;
+    virtual void unmap(int slot, void * base) = 0;
+    virtual const void * map_read(int slot) = 0;
+    virtual void unmap_read(int slot, const void * base) = 0;
+    virtual size_t slice_offset(int slot, int p) const = 0;
+    // Write one expert (its three slices in GGUF block layout, src[p] of bytes[p]; down of type t_down) into a slot:
+    // map_write, copy -- or, for a backend whose slots use their own layout, repack -- and unmap. False on failure.
+    virtual bool write_expert(int slot, const void * const src[3], const size_t bytes[3], ggml_type t_down);
+    // True when a slot's bytes are GGUF block layout, so map_read() pointers can be given to ggml directly. When
+    // false, the CPU paths must copy the expert out with read_expert() instead.
+    virtual bool native_layout() const { return true; }
+    // Copy a slot's expert out in GGUF block layout into dst[p] (sizes as written). Only for !native_layout().
+    virtual bool read_expert(int slot, void * const dst[3], ggml_type t_down) { (void) slot; (void) dst; (void) t_down; return false; }
+    // Start computing k experts' FFNs: slots[i] holds expert i's weights, of the given ggml types; x is the fp32
+    // input row (n_embd), shared by all k (may be reused on return); out receives k rows of n_embd floats and must
+    // stay valid until wait(). Returns false if it cannot start.
+    virtual bool dispatch(int layer, ggml_type t_gate, ggml_type t_up, ggml_type t_down, int k, const int * slots,
+                          const float * x, float * out) = 0;
+    // Block until the last dispatch has completed. Returns false if it failed (out is then undefined).
+    virtual bool wait() = 0;
+    // After wait(): bit i set = slot i's result may be inexact on this device; the caller recomputes it on the CPU.
+    virtual uint32_t last_risk_mask() const { return 0; }
+    // After wait(): device time of the last dispatch in ns, 0 if not measured.
+    virtual uint64_t last_device_ns() const { return 0; }
+    // Unmap calls the device reported as failed, over the run (reported with the tier's counters).
+    virtual long long map_errors() const { return 0; }
+};
+
+std::unique_ptr<GpuExpertsBackend> make_gpu_backend_standin();
+// CPU-only memory from the GPU driver: an OpenCL CL_MEM_ALLOC_HOST_PTR buffer of `bytes`, mapped READ|WRITE once and
+// never unmapped (the device never reads it, so the map/unmap coherence protocol does not apply). nullptr + *err when
+// this build has no OpenCL (BMOE_HAVE_GX undefined) or the driver refuses.
+void * gpu_pinned_alloc(size_t bytes, std::string * err);
+// nullptr when this build has no libgx (BMOE_HAVE_GX undefined) or the device cannot be opened (reason in *err).
+std::unique_ptr<GpuExpertsBackend> make_gpu_backend_gx(int variant, std::string * err, int spin_wait = 0);
+
+} // namespace bmoe
