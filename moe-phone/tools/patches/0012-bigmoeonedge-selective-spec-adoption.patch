+// moe-phone 0012 --spec-adopt-selective. Called at layer il's load with il's TRUE routed ids, in
+// place of the destructive quiesce. Eval thread only (LRU mutation), like every quiesce.
+//   confirmed (spec entry of il that the router chose): adopt — move its unstarted jobs to the front,
+//     wait for the entry to finish, integrate it HOT; the staging that follows sees a hit.
+//   refuted (spec entry of il the router did not choose): if NONE of its reads has started, remove
+//     its jobs and release its pages (no lane can be writing them: every job is still in the queue,
+//     and lanes take jobs under io_mtx_, which is held here). Otherwise leave it to finish; it then
+//     integrates at the cold end like any guess.
+//   other layers: untouched (still queued, or completed and integrated cold).
+// Safety argument for the release: an entry's spec_remaining_ counts its unfinished jobs; if that
+// equals the number of its jobs still queued, none is in flight.
+void ExpertStreamSource::quiesce_selective(int il, const int32_t * ids, int n_ids) {
+    ++sel_quiesces_;
+    sel_need_.assign((size_t) n_expert_, (uint8_t) 0);
+    for (int i = 0; i < n_ids; ++i)
+        if (ids[i] >= 0 && ids[i] < n_expert_) sel_need_[(size_t) ids[i]] = 1;
+    sel_qcnt_.assign((size_t) n_expert_, 0);
+    std::vector<int32_t> & adopt = spec_adopt_ids_;
+    std::vector<int32_t> & cancel = sel_cancel_ids_;
+    adopt.clear();
+    cancel.clear();
+    {
+        std::lock_guard<std::mutex> lk(io_mtx_);
+        for (size_t q = spec_next_; q < spec_jobs_.size(); ++q)
+            if (spec_jobs_[q].layer == (int16_t) il) ++sel_qcnt_[(size_t) spec_jobs_[q].expert];
+        for (int32_t id : spec_touched_) {
+            if (id / n_expert_ != il || spec_remaining_[id] == 0) continue;
+            const int e = id % n_expert_;
+            if (sel_need_[(size_t) e]) {
+                adopt.push_back(id);
+            } else if (sel_qcnt_[(size_t) e] == spec_remaining_[id]) {
+                cancel.push_back(id);
+                spec_remaining_[id] = 0;
+            } else {
+                ++sel_left_;
+            }
+        }
+        if (!cancel.empty()) {
+            auto first = spec_jobs_.begin() + (ptrdiff_t) spec_next_;
+            auto last = std::remove_if(first, spec_jobs_.end(), [&](const IoJob & j) {
+                if (j.layer != (int16_t) il || sel_need_[(size_t) j.expert]) return false;
+                const int32_t id = (int32_t) il * n_expert_ + j.expert;
+                if (spec_remaining_[id] != 0) return false; // partly started: keep, it finishes
+                sel_cancel_bytes_ += (long long) j.nbytes;
+                return true;
+            });
+            spec_jobs_.erase(last, spec_jobs_.end());
+        }
+        // Confirmed jobs first, so idle lanes finish exactly what this load is about to wait on.
+        std::stable_partition(spec_jobs_.begin() + (ptrdiff_t) spec_next_, spec_jobs_.end(),
+                              [&](const IoJob & j) { return j.layer == (int16_t) il && sel_need_[(size_t) j.expert]; });
+        spec_touched_.erase(std::remove_if(spec_touched_.begin(), spec_touched_.end(),
+                                           [&](int32_t id) { return spec_remaining_[id] == 0; }),
+                            spec_touched_.end());
+    }
+    for (int32_t id : cancel) {
+        release_entry_pages(id);
+        ++sel_cancelled_;
+    }
+    sel_adopted_ += (long long) adopt.size();
+    if (!adopt.empty()) {
+        io_cv_.notify_all();
+        if (!overlap_) drain_adopted(il);
+        const auto tw0 = clock_t_::now();
+        {
+            std::unique_lock<std::mutex> lk(io_mtx_);
+            io_cv_done_.wait(lk, [&] {
+                if (io_stop_) return true;
+                for (int32_t id : adopt)
+                    if (spec_remaining_[id] != 0) return false;
+                return true;
+            });
+        }
+        adopt_wait_ns_ +=
+            (long long) std::chrono::duration_cast<std::chrono::nanoseconds>(clock_t_::now() - tw0).count();
+    }
+    sel_layer_ = il;
+    spec_integrate_done();
+    sel_layer_ = -1;
+}
