+        static const char * pats[] = { "attn_q.weight", "attn_k.weight", "attn_v.weight", "attn_output.weight" };
+        bmoe_attn_overrides.clear();
+        for (const char * p : pats) {
+            bmoe_attn_overrides.push_back({ p, abuft });
+        }
+        bmoe_attn_overrides.push_back({ nullptr, nullptr });
+        mparams.tensor_buft_overrides = bmoe_attn_overrides.data();
