# moe-phone patch for github.com/Helldez/BigMoeOnEdge @ 74ba18f, applied AFTER 0002-0008.
# Two changes, both needed to run OUR engine on the Hexagon NPU:
#   --attn-device NAME  put the attention weights (attn_q/k/v/output) on another ggml device via
#                       llama.cpp's tensor_buft_overrides, while the routed experts keep streaming
#                       into host memory and running on the CPU under --overlap. The output head
#                       cannot move: it is Q6_K here and ggml-hexagon refuses ne[1] > 32768 anyway.
#   bmoe_main()         the CLI as a shared library symbol, because the DSP session only opens inside
#                       an app's own process (results/2026-09-17/npu_inprocess), so the app shim
#                       dlsyms the engine instead of exec'ing it.
# ===== engine (BigMoeOnEdge root) =====
diff --git a/cli/CMakeLists.txt b/cli/CMakeLists.txt
--- a/cli/CMakeLists.txt
+++ b/cli/CMakeLists.txt
@@ -1,2 +1,8 @@
 add_executable(bmoe-cli main.cpp)
 target_link_libraries(bmoe-cli PRIVATE bmoe_core)
+
+# moe-phone: the same CLI as a shared library exporting bmoe_main(argc, argv), so an app process (the only
+# place the Hexagon NPU session opens) can run the engine in-process via dlsym instead of exec'ing it.
+add_library(bmoe_entry SHARED main.cpp)
+target_link_libraries(bmoe_entry PRIVATE bmoe_core)
+set_target_properties(bmoe_entry PROPERTIES OUTPUT_NAME bmoe_entry)
diff --git a/cli/main.cpp b/cli/main.cpp
--- a/cli/main.cpp
+++ b/cli/main.cpp
@@ -448,6 +448,7 @@
         "      --cpu-mask HEX      pin the compute threadpool to these cores, strict (moe-phone)\n"
         "      --io-cpu-mask HEX   pin the expert-read lanes to these cores (moe-phone)\n"
         "      --ppl-batch N       with --ppl: N teacher-forced tokens per decode (prices a verify batch) (moe-phone)\n"
+        "      --attn-device N     run the attention matmuls on ggml device N (HTP0 / GPUOpenCL), experts stay streamed on CPU (moe-phone)\n"
         "      --slot-arena        expert slices in never-released pool slots read via a MUL_MAT_ID pointer hook (moe-phone)\n"
         "      --defer-evict       batch evicted pages' release after each decode (moe-phone)\n"
         "      --recycle-pages     move evicted experts' pages into the next miss (mremap) instead of re-faulting (moe-phone)\n"
@@ -592,7 +593,15 @@
     }
 }
 
+// moe-phone: the same entry point as a callable symbol. The Hexagon NPU session only opens inside an
+// app's own process, so the app shim (results/2026-09-17/npu_inprocess) dlsyms this instead of exec'ing.
+extern "C" int bmoe_main(int argc, char ** argv);
+
 int main(int argc, char ** argv) {
+    return bmoe_main(argc, argv);
+}
+
+extern "C" int bmoe_main(int argc, char ** argv) {
     RunConfig cfg;
     std::string csv_path;
     std::string route_trace_path;
