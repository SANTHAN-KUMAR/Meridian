+const char * ExpertStreamSource::c_expert_data(const ggml_tensor * src0, int expert, void * self_) {
+    auto * self = (ExpertStreamSource *) self_;
+    const void * key = (const void *) src0;
+    auto it = std::lower_bound(self->texp_.begin(), self->texp_.end(), key,
+                               [](const std::pair<const void *, uint32_t> & a, const void * k) { return a.first < k; });
+    if (it == self->texp_.end() || it->first != key) return nullptr;
+    const int il = (int) (it->second >> 8), p = (int) (it->second & 0xff);
+    if (expert < 0 || expert >= self->n_expert_) return nullptr;
+    return self->arena_ptr_[p][(size_t) il * (size_t) self->n_expert_ + (size_t) expert];
+}
