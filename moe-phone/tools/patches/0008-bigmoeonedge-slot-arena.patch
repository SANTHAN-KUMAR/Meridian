+char * ExpertStreamSource::arena_slot(int il, int e, int p) {
+    const size_t id = (size_t) il * (size_t) n_expert_ + (size_t) e;
+    if (arena_ptr_[p][id]) return arena_ptr_[p][id];
+    const uint64_t slice = layers_[il].proj[p].nb2;
+    auto & fl = arena_free_[slice];
+    if (fl.empty()) {
+        // grow the pool by 32 slots; pages are populated on first write and never released
+        const size_t n = 32, sz = (size_t) slice * n;
+        void * blk = pio::vm_reserve(sz);
+        if (!blk) return nullptr;
+        arena_blocks_.push_back({blk, sz});
+        for (size_t k = 0; k < n; ++k) fl.push_back((char *) blk + (size_t) slice * k);
+        arena_slots_ += (long long) n;
+    } else {
+        ++arena_reuse_;
+    }
+    char * slot = fl.back();
+    fl.pop_back();
+    arena_ptr_[p][id] = slot;
+    return slot;
+}
