 // ── LRU plumbing ────────────────────────────────────────────────────────────────────
 void ExpertStreamSource::lru_unlink(int32_t id) {
+    // moe-phone --expert-slru: an entry belongs to exactly one of the two lists, and which one is
+    // recorded in cprot_, so unlink stays a single O(1) splice either way.
+    const bool prot = slru_ && !cprot_.empty() && cprot_[id];
+    int32_t & head = prot ? phead_ : chead_;
+    int32_t & tail = prot ? ptail_ : ctail_;
+    int32_t pv = cprev_[id], nx = cnext_[id];
     if (pv != -1)
         cnext_[pv] = nx;
     else
-        chead_ = nx;
+        head = nx;
     if (nx != -1)
         cprev_[nx] = pv;
     else
-        ctail_ = pv;
+        tail = pv;
     cprev_[id] = cnext_[id] = -1;
 }
+
+// moe-phone: MRU end of the protected list.
+void ExpertStreamSource::prot_push_front(int32_t id) {
+    cprev_[id] = -1;
+    cnext_[id] = phead_;
+    if (phead_ != -1)
+        cprev_[phead_] = id;
+    else
+        ptail_ = id;
+    phead_ = id;
+}
+
+// moe-phone: second sighting -> protected. Called with the entry already unlinked from probation.
+void ExpertStreamSource::slru_promote(int32_t id) {
+    cprot_[id] = 1;
+    cprot_bytes_ += entry_bytes(id / n_expert_);
+    prot_push_front(id);
+    ++slru_promotions_;
+    slru_demote_to_budget();
+}
+
+// moe-phone: keep the protected list within its share of the budget by demoting its cold tail back to
+// probation (NOT by dropping it: a demoted entry is still resident and still a hit if it is used).
+void ExpertStreamSource::slru_demote_to_budget() {
+    const size_t prot_max = (size_t) (slru_prot_frac_ * (double) cache_max_);
+    while (cprot_bytes_ > prot_max && ptail_ != -1) {
+        const int32_t victim = ptail_;
+        lru_unlink(victim);
+        cprot_[victim] = 0;
+        cprot_bytes_ -= entry_bytes(victim / n_expert_);
+        lru_push_front(victim);   // demote to the WARM end of probation
+        ++slru_demotions_;
+    }
+}
