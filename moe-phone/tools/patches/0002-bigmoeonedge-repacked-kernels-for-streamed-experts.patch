+
+// ---- moe-phone: repacked kernels for externally streamed expert tensors -------------------------
+// A tensor whose ->buffer has the repack buffer type and whose ->extra holds its traits is dispatched
+// to the repacked kernels by ggml_cpu_extra_compute_forward (traits.cpp). A streaming engine rebinds
+// expert ->data to its own cache, so the tensor cannot live in a real repack buffer; it is tagged with
+// one shared 64-byte repack buffer instead, and each expert slice is repacked in place when it lands.
+#include <mutex>
+static ggml_backend_buffer_t g_moe_repack_tag = nullptr;
+static std::mutex            g_moe_repack_mtx;
+
+extern "C" {
+
+bool ggml_cpu_repack_bind_tensor(struct ggml_tensor * t) {
+    const auto * traits = ggml_repack_get_optimal_repack_type(t);
+    if (!traits) {
+        return false;
+    }
+    {
+        std::lock_guard<std::mutex> lk(g_moe_repack_mtx);
+        if (!g_moe_repack_tag) {
+            g_moe_repack_tag = ggml_backend_buft_alloc_buffer(ggml_backend_cpu_repack_buffer_type(), 64);
+        }
+    }
+    if (!g_moe_repack_tag) {
+        return false;
+    }
+    t->extra  = (void *) const_cast<ggml::cpu::tensor_traits *>(traits);
+    t->buffer = g_moe_repack_tag;
+    return true;
+}
+
+bool ggml_cpu_repack_is_bound(const struct ggml_tensor * t) {
+    return g_moe_repack_tag != nullptr && t->buffer == g_moe_repack_tag && t->extra != nullptr;
+}
+
+bool ggml_cpu_repack_slice(const struct ggml_tensor * t, void * slice, size_t nbytes) {
+    if (!ggml_cpu_repack_is_bound(t)) {
+        return false;
+    }
+    ggml_tensor tmp = *t;          // one expert: a 2-D view of the 3-D expert tensor
+    tmp.ne[2] = 1;
+    tmp.ne[3] = 1;
+    tmp.data  = slice;
+    const size_t expect = (size_t) (tmp.ne[0] / ggml_blck_size(tmp.type)) * ggml_type_size(tmp.type) * (size_t) tmp.ne[1];
+    if (nbytes != expect) {
+        return false;              // never repack a partial or mis-sized slice
+    }
+    thread_local std::vector<uint8_t> src;
+    src.assign((uint8_t *) slice, (uint8_t *) slice + nbytes);
+    auto * tb = (ggml::cpu::repack::tensor_traits_base *) t->extra;
+    return tb->repack(&tmp, src.data(), nbytes) == 0;
+}
+
+} // extern "C"
