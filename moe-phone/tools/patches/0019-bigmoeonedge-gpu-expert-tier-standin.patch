+// ── moe-phone 0019: the GPU expert tier (gpu_tier.h; research/2026-09-18_gpu_expert_path_design.md §12) ──────
+bool ExpertStreamSource::gtier_init(const MoeStreamConfig & cfg, const std::vector<std::string> & shard_paths) {
+    if (cache_max_ == 0 || arena_ || recycle_pages_ || defer_evict_ || !overlap_) {
+        std::fprintf(stderr, "bmoe: gpu-tier needs the plain LRU/SLRU cache with --overlap (not shared-slot, --slot-arena, "
+                             "--recycle-pages or --defer-evict)\n");
+        return false;
+    }
+    GpuTierShape sh{};
+    for (int p = 0; p < 3; ++p) sh.slice_bytes[p] = 0;
+    for (const LayerExperts & L : layers_) {
+        if (!L.bound) continue;
+        // separate gate, up, down, as llama.cpp's build_moe_ffn computes them (up, gate, swiglu_split, down); a fused
+        // gate_up layout or a missing projection is a different graph the device does not implement
+        for (int p = 0; p < 3; ++p)
+            if (!L.proj[p].tensor || !L.proj[p].nb2) {
+                std::fprintf(stderr, "bmoe: gpu-tier: layer without separate gate/up/down experts; unsupported\n");
+                return false;
+            }
+        const ggml_tensor * g = L.proj[0].tensor;
+        const ggml_tensor * d = L.proj[2].tensor;
+        if (sh.n_embd == 0) { sh.n_embd = (int) g->ne[0]; sh.n_ff = (int) g->ne[1]; }
+        if (g->ne[0] != sh.n_embd || g->ne[1] != sh.n_ff || d->ne[0] != sh.n_ff || d->ne[1] != sh.n_embd) {
+            std::fprintf(stderr, "bmoe: gpu-tier: expert shapes differ across layers; unsupported\n");
+            return false;
+        }
+        for (int p = 0; p < 3; ++p) sh.slice_bytes[p] = std::max<size_t>(sh.slice_bytes[p], (size_t) L.proj[p].nb2);
+    }
+    size_t slot_bytes = 0;
+    for (int p = 0; p < 3; ++p) slot_bytes += (sh.slice_bytes[p] + 4095) & ~(size_t) 4095;
+    const int want = (int) (((size_t) cfg.gpu_tier_mb << 20) / slot_bytes);
+    if (want <= 0) return false;
+    const std::string backend = cfg.gpu_backend ? cfg.gpu_backend : "";
+    if (backend == "standin") {
+        gpu_ = make_gpu_backend_standin();
+    } else if (backend == "gx") {
+        std::string err;
+        gpu_ = make_gpu_backend_gx(cfg.gpu_variant, &err);
+        if (!gpu_) { std::fprintf(stderr, "bmoe: gpu-tier: gx backend unavailable: %s\n", err.c_str()); return false; }
+    } else {
+        std::fprintf(stderr, "bmoe: gpu-tier: unknown backend '%s'\n", backend.c_str());
+        return false;
+    }
+    if (!gcpu_ffn_.init(sh.n_embd, sh.n_ff)) return false;
+    const int n = gpu_->init(sh, want);
+    if (n <= 0) return false;
+    // the tier's memory comes OUT of the CPU cache budget, so the run's total stays what the budget allowed
+    const size_t take = std::min(cache_max_ / 2, (size_t) n * slot_bytes);
+    gt_cpu_budget_taken_ = take;
+    cache_max_ -= take;
+    const size_t n_entry = (size_t) n_layer_ * (size_t) n_expert_;
+    gslot_of_.assign(n_entry, -1);
+    ghits_.assign(n_entry, 0);
+    gowner_.assign((size_t) n, -1);
+    gprev_.assign((size_t) n, -1);
+    gnext_.assign((size_t) n, -1);
+    gfree_.clear();
+    for (int i = n - 1; i >= 0; --i) gfree_.push_back(i);
+    gpromote_hits_ = std::max(1, cfg.gpu_promote_hits);
+    gmax_per_layer_ = std::max(0, cfg.gpu_max_per_layer);
+    gpromo_per_token_ = std::max(0, cfg.gpu_promotions_per_token);
+    gref_.assign((size_t) n, 0);
+    gover_slot_.assign((size_t) n_expert_, -1);
+    gover_base_.assign((size_t) n_expert_, nullptr);
+    for (int p = 0; p < 3; ++p) gover_ptr_[p].assign((size_t) n_expert_, nullptr);
+    gtier_on_ = true;
+    if (cfg.gpu_tier_prior && cfg.gpu_tier_prior[0]) gt_warm_ = gtier_warm_start(cfg.gpu_tier_prior, shard_paths);
+    std::fprintf(stderr, "bmoe: gpu-tier: warm start filled %lld slots from %s\n", gt_warm_,
+                 (cfg.gpu_tier_prior && cfg.gpu_tier_prior[0]) ? cfg.gpu_tier_prior : "(none)");
+    std::fprintf(stderr, "bmoe: gpu-tier: backend %s, %d slots x %zu KiB (n_embd %d, n_ff %d), promote after %d hits, "
+                         "at most %d device experts per layer, CPU cache budget now %zu MiB\n", gpu_->name(), n,
+                 slot_bytes >> 10, sh.n_embd, sh.n_ff, gpromote_hits_, gmax_per_layer_, cache_max_ >> 20);
+    return true;
+}
+
+// Fill the tier at load from a popularity list, reading each expert's three slices straight from the model file into
+// its slot (map, pread, unmap). The CPU tier is empty at this point, so no expert is held twice. Returns slots filled.
+int ExpertStreamSource::gtier_warm_start(const char * prior_path, const std::vector<std::string> & shard_paths) {
+#if defined(__linux__)
+    FILE * f = std::fopen(prior_path, "r");
+    if (!f) { std::fprintf(stderr, "bmoe: gpu-tier: cannot open prior %s\n", prior_path); return 0; }
+    std::vector<int> fds(shard_paths.size(), -1);
+    for (size_t i = 0; i < shard_paths.size(); ++i) fds[i] = ::open(shard_paths[i].c_str(), O_RDONLY | O_CLOEXEC);
+    int filled = 0;
+    int il = 0, e = 0;
+    char line[128];
+    while (!gfree_.empty() && std::fgets(line, sizeof(line), f)) {
+        if (std::sscanf(line, "%d %d", &il, &e) != 2) continue;
+        if (il < 0 || il >= n_layer_ || e < 0 || e >= n_expert_ || !layers_[il].bound) continue;
+        const int32_t id = il * n_expert_ + e;
+        if (gslot_of_[id] >= 0) continue;
+        const LayerExperts & L = layers_[il];
+        const int32_t sl = gfree_.back();
+        char * base = (char *) gpu_->map_write(sl);
+        if (!base) break;
+        bool ok = true;
+        for (int p = 0; p < 3 && ok; ++p) {
+            const uint64_t slice = L.proj[p].nb2;
+            const int fd = fds[(size_t) L.proj[p].file_idx];
+            const uint64_t off = L.proj[p].file_off + (uint64_t) e * slice;
+            size_t done = 0;
+            while (done < slice) {
+                const ssize_t r = ::pread(fd, base + gpu_->slice_offset(sl, p) + done, slice - done, (off_t) (off + done));
+                if (r <= 0) { ok = false; break; }
+                done += (size_t) r;
+            }
+            if (ok) ::posix_fadvise(fd, (off_t) off, (off_t) slice, POSIX_FADV_DONTNEED); // one-time read: keep no page cache
+        }
+        gpu_->unmap(sl, base);
+        if (!ok) { std::fprintf(stderr, "bmoe: gpu-tier: warm start read failed at layer %d expert %d\n", il, e); break; }
+        gfree_.pop_back();
+        gslot_of_[id] = sl;
+        gowner_[sl] = id;
+        gref_[sl] = 0;
+        gprev_[sl] = gtail_;   // append at the tail: the list's order is most popular first
+        gnext_[sl] = -1;
+        if (gtail_ != -1) gnext_[gtail_] = sl; else ghead_ = sl;
+        gtail_ = sl;
+        ++filled;
+    }
+    for (int fd : fds) if (fd >= 0) ::close(fd);
+    std::fclose(f);
+    return filled;
+#else
+    (void) prior_path; (void) shard_paths;
+    return 0;
+#endif
+}
+
+void ExpertStreamSource::gtier_touch(int32_t s) {
+    gref_[s] = 1;
+    if (ghead_ == s) return;
+    // unlink
+    if (gprev_[s] != -1) gnext_[gprev_[s]] = gnext_[s]; else if (ghead_ == s) ghead_ = gnext_[s];
+    if (gnext_[s] != -1) gprev_[gnext_[s]] = gprev_[s]; else if (gtail_ == s) gtail_ = gprev_[s];
+    // push front
+    gprev_[s] = -1;
+    gnext_[s] = ghead_;
+    if (ghead_ != -1) gprev_[ghead_] = s;
+    ghead_ = s;
+    if (gtail_ == -1) gtail_ = s;
+}
+
+void ExpertStreamSource::gtier_evict_tail() {
+    const int32_t s = gtail_;
+    if (s < 0) return;
+    const int32_t id = gowner_[s];
+    gtail_ = gprev_[s];
+    if (gtail_ != -1) gnext_[gtail_] = -1; else ghead_ = -1;
+    gprev_[s] = gnext_[s] = -1;
+    gowner_[s] = -1;
+    if (id >= 0) { gslot_of_[id] = -1; ghits_[id] = 0; }
+    gfree_.push_back(s);
+    ++gt_evictions_;
+}
+
+void ExpertStreamSource::gtier_release_overflow() {
+    for (int32_t e : gover_list_) {
+        const int32_t slot = gover_slot_[(size_t) e];
+        if (gover_base_[(size_t) e]) gpu_->unmap_read(slot, gover_base_[(size_t) e]);
+        gover_base_[(size_t) e] = nullptr;
+        for (int p = 0; p < 3; ++p) gover_ptr_[p][(size_t) e] = nullptr;
+        gover_slot_[(size_t) e] = -1;
+    }
+    gover_list_.clear();
+    gover_layer_ = -1;
+}
+
+void ExpertStreamSource::gtier_flush() {
+    while (gtail_ != -1) gtier_evict_tail();
+    ++gt_flushes_;
+}
+
+void ExpertStreamSource::gtier_release_cpu(int32_t id) {
+    // evict_tail's bookkeeping for one chosen entry, without counting an eviction (the expert is moving tiers)
+    lru_unlink(id); // before cprot_ changes: it picks the list from cprot_
+    const int il = id / n_expert_;
+    if (slru_ && !cprot_.empty() && cprot_[id]) {
+        cprot_bytes_ -= entry_bytes(il);
+        cprot_[id] = 0;
+    }
+    release_entry_pages(id);
+    cvalid_[id] = 0;
+    cspec_[id] = 0;
+    cresident_ -= entry_bytes(il);
+}
+
+bool ExpertStreamSource::gtier_promote(int32_t id) {
+    if (gpromo_left_ <= 0) { ++gt_budget_denied_; return false; }
+    if (gfree_.empty()) {
+        // second-chance admission (design §13): a tail slot used since it was last examined survives, and the
+        // candidate waits; only an unreferenced tail is evicted. Bounds churn to what the tier's own misses justify.
+        const int32_t t = gtail_;
+        if (t < 0) return false;
+        if (gref_[t]) {
+            gref_[t] = 0;
+            gtier_touch(t);   // to the head, bit cleared by the next line
+            gref_[t] = 0;
+            ++gt_rejected_;
+            return false;
+        }
+        gtier_evict_tail();
+    }
+    if (gfree_.empty()) return false;
+    const int32_t s = gfree_.back();
+    gfree_.pop_back();
+    const int il = id / n_expert_, e = id % n_expert_;
+    const LayerExperts & L = layers_[il];
+    char * base = (char *) gpu_->map_write(s);
+    if (!base) { gfree_.push_back(s); ++gt_fail_; return false; }
+    for (int p = 0; p < 3; ++p) {
+        const uint64_t slice = L.proj[p].nb2;
+        std::memcpy(base + gpu_->slice_offset(s, p), (const char *) lbuf_[p][il] + (uint64_t) e * slice, slice);
+    }
+    gpu_->unmap(s, base);
+    gtier_release_cpu(id);
+    gslot_of_[id] = s;
+    gowner_[s] = id;
+    gref_[s] = 0;
+    gprev_[s] = -1;
+    gnext_[s] = ghead_;
+    if (ghead_ != -1) gprev_[ghead_] = s;
+    ghead_ = s;
+    if (gtail_ == -1) gtail_ = s;
+    ++gt_promotions_;
+    --gpromo_left_;
+    return true;
+}
+
+bool ExpertStreamSource::c_mmid_begin(const ggml_tensor * dst, unsigned char * skip, int n_as, void * ud) {
+    return static_cast<ExpertStreamSource *>(ud)->on_mmid_begin(dst, skip, n_as);
+}
+void ExpertStreamSource::c_mmid_end(const ggml_tensor * dst, void * ud) {
+    static_cast<ExpertStreamSource *>(ud)->on_mmid_end(dst);
+}
+
+// Thread 0, once per MUL_MAT_ID, before the op's barrier (ggml-cpu split hooks, patch 0017).
+// The layer's plan is made at its FIRST expert op (up, in llama.cpp's graph) and reused by the others:
+//   decode (one token): up to gmax_per_layer_ owned experts go to the device (dispatched here, skipped by the CPU,
+//     filled at down's end); owned experts beyond the cap are read-mapped for the CPU (data hook);
+//   multi-token batch: no device; every owned expert is read-mapped for the CPU. No dispatch is in flight then.
+bool ExpertStreamSource::on_mmid_begin(const ggml_tensor * dst, unsigned char * skip, int n_as) {
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    const ggml_tensor * ids = dst->src[2];
+    auto it = std::lower_bound(texp_.begin(), texp_.end(), (const void *) src0,
+                               [](const std::pair<const void *, uint32_t> & a, const void * k) { return a.first < k; });
+    if (it == texp_.end() || it->first != (const void *) src0) return false;
+    const int il = (int) (it->second >> 8);
+    const int p = (int) (it->second & 0xff);
+    const int nu = (int) ids->ne[0];
+    const int nt = (int) ids->ne[1];
+    const bool decode = (nt == 1 && dst->ne[2] == 1 && cur_nt_ == 1);
+    if (gplan_seq_ != gload_seq_) {
+        gplan_seq_ = gload_seq_;
+        gplan_layer_ = il;
+        gdisp_slotpos_.clear();
+        gdisp_slots_.clear();
+        std::vector<int> dev_e;
+        for (int t = 0; t < nt; ++t) {
+            for (int s = 0; s < nu; ++s) {
+                const int e = *(const int32_t *) ((const char *) ids->data + (size_t) s * ids->nb[0] + (size_t) t * ids->nb[1]);
+                if (e < 0 || e >= n_as || e >= n_expert_) continue;
+                const int32_t slot = gslot_of_[(size_t) il * (size_t) n_expert_ + (size_t) e];
+                if (slot < 0) continue;
+                if (decode && (int) gdisp_slots_.size() < gmax_per_layer_) {
+                    gdisp_slotpos_.push_back(s);
+                    gdisp_slots_.push_back(slot);
+                    dev_e.push_back(e);
+                    continue;
+                }
+                if (gover_slot_[(size_t) e] >= 0) continue; // already read-mapped for this layer
+                const char * base = (const char *) gpu_->map_read(slot);
+                if (!base) {
+                    std::fprintf(stderr, "bmoe: gpu-tier FATAL: read-map of slot %d failed (layer %d)\n", slot, il);
+                    std::abort();
+                }
+                gover_layer_ = il;
+                gover_slot_[(size_t) e] = slot;
+                gover_base_[(size_t) e] = base;
+                for (int q = 0; q < 3; ++q) gover_ptr_[q][(size_t) e] = base + gpu_->slice_offset(slot, q);
+                gover_list_.push_back(e);
+                ++gt_overflow_;
+            }
+        }
+        gdisp_e_ = dev_e;
+        if (!gdisp_slots_.empty()) {
+            if (p == 2 || src1->type != GGML_TYPE_F32 || src1->ne[0] != layers_[il].proj[0].tensor->ne[0]) {
+                std::fprintf(stderr, "bmoe: gpu-tier FATAL: first expert op of layer %d is proj %d with an unexpected input\n", il, p);
+                std::abort();
+            }
+            gout_.resize(gdisp_slots_.size() * (size_t) src1->ne[0]);
+            gx_x_.assign((const float *) src1->data, (const float *) src1->data + src1->ne[0]); // kept for risk recompute
+            const LayerExperts & L = layers_[il];
+            if (!gpu_->dispatch(il, L.proj[0].tensor->type, L.proj[1].tensor->type, L.proj[2].tensor->type,
+                                (int) gdisp_slots_.size(), gdisp_slots_.data(), gx_x_.data(), gout_.data())) {
+                ++gt_fail_;
+                std::fprintf(stderr, "bmoe: gpu-tier FATAL: dispatch failed at layer %d (the CPU copies are released)\n", il);
+                std::abort();
+            }
+            gdispatch_seq_ = gload_seq_;
+            gdispatch_layer_ = il;
+            ++gt_dispatches_;
+            gt_experts_ += (long long) gdisp_slots_.size();
+        }
+    } else if (il != gplan_layer_) {
+        std::fprintf(stderr, "bmoe: gpu-tier FATAL: expert op of layer %d inside the plan of layer %d\n", il, gplan_layer_);
+        std::abort();
+    }
+    if (gdisp_slots_.empty() || gdispatch_seq_ != gload_seq_) return false; // nothing on the device for this layer
+    for (size_t i = 0; i < gdisp_slotpos_.size(); ++i) {
+        const int s = gdisp_slotpos_[i];
+        const int e = *(const int32_t *) ((const char *) ids->data + (size_t) s * ids->nb[0]);
+        if (e != gdisp_e_[i]) {
+            std::fprintf(stderr, "bmoe: gpu-tier FATAL: layer %d proj %d routes slot %d to expert %d, dispatched %d\n", il, p, s, e, gdisp_e_[i]);
+            std::abort();
+        }
+        skip[e] = 1;
+        std::memset((char *) dst->data + (size_t) s * dst->nb[1], 0, (size_t) dst->ne[0] * sizeof(float));
+    }
+    return true;
+}
+
+// Thread 0, after its own share of the op; only called if begin returned true (a dispatch exists for this layer).
+void ExpertStreamSource::on_mmid_end(const ggml_tensor * dst) {
+    const ggml_tensor * src0 = dst->src[0];
+    auto it = std::lower_bound(texp_.begin(), texp_.end(), (const void *) src0,
+                               [](const std::pair<const void *, uint32_t> & a, const void * k) { return a.first < k; });
+    if (it == texp_.end() || it->first != (const void *) src0) return;
+    const int il = (int) (it->second >> 8);
+    const int p = (int) (it->second & 0xff);
+    if (p != 2) return; // gate/up: the device's result arrives with down
+    if (gdispatch_seq_ != gload_seq_ || gdispatch_layer_ != il) {
+        std::fprintf(stderr, "bmoe: gpu-tier FATAL: down of layer %d has no dispatch of its own to fill from\n", il);
+        std::abort();
+    }
+    const auto t0 = clock_t_::now();
+    if (!gpu_->wait()) {
+        ++gt_fail_;
+        std::fprintf(stderr, "bmoe: gpu-tier FATAL: device reported failure at layer %d\n", gdispatch_layer_);
+        std::abort();
+    }
+    gt_wait_ns_ += (long long) std::chrono::duration_cast<std::chrono::nanoseconds>(clock_t_::now() - t0).count();
+    gt_device_ns_ += (long long) gpu_->last_device_ns();
+    const size_t n_embd = (size_t) dst->ne[0];
+    // The device flags slots whose values entered a range it may compute inexactly (denormal flush): recompute those
+    // experts on the CPU with ggml's own arithmetic, exact, and count them (moe-phone gx risk detector).
+    if (const uint32_t risk = gpu_->last_risk_mask()) {
+        const LayerExperts & L = layers_[gdispatch_layer_];
+        for (size_t i = 0; i < gdisp_slots_.size(); ++i) {
+            if (!(risk & (1u << i))) continue;
+            const int slot = gdisp_slots_[i];
+            const char * base = (const char *) gpu_->map_read(slot); // no dispatch in flight after wait()
+            if (!base || !gcpu_ffn_.run(L.proj[0].tensor->type, L.proj[1].tensor->type, L.proj[2].tensor->type,
+                                       base + gpu_->slice_offset(slot, 0), base + gpu_->slice_offset(slot, 1),
+                                       base + gpu_->slice_offset(slot, 2), gx_x_.data(), gout_.data() + i * n_embd)) {
+                std::fprintf(stderr, "bmoe: gpu-tier FATAL: risk recompute failed (layer %d slot %d)\n", gdispatch_layer_, slot);
+                std::abort();
+            }
+            gpu_->unmap_read(slot, base);
+            ++gt_risk_recomputed_;
+        }
+    }
+    for (size_t i = 0; i < gdisp_slotpos_.size(); ++i)
+        std::memcpy((char *) dst->data + (size_t) gdisp_slotpos_[i] * dst->nb[1], gout_.data() + i * n_embd, n_embd * sizeof(float));
+}
