+++ b/core/src/moe/gpu_tier.h
@@ -0,0 +1,55 @@
+// gpu_tier.h — moe-phone (patch 0019): the device side of the GPU expert tier.
+//
+// The engine keeps two tiers of expert residency (moe-phone research/2026-09-18_gpu_expert_path_design.md §12):
+// the CPU tier (the anon LRU/SLRU cache) and this GPU tier, a pool of slots each holding ONE expert's three
+// slices (gate, up, down). An expert lives in exactly one tier. At decode (one token), every selected expert the
+// GPU tier owns is computed by the device -- its whole FFN, gate, up, SwiGLU, down -- in one dispatch per layer,
+// concurrently with the CPU's MUL_MAT_ID over the rest (ggml-cpu split hooks, patch 0017).
+//
+// Backends:
+//   standin  CPU implementation on its own thread, bit-identical to ggml-cpu's MUL_MAT_ID + swiglu_split rows by
+//            construction (type-traits from_float + vec_dot per row, as mul_mat_id's one_chunk; SwiGLU through a
+//            one-op ggml graph). It exists so the whole engine can be checked for byte-identical text with the tier
+//            ON vs OFF on a laptop, before any OpenCL is linked.
+//   gx       libgx (moe-phone/host/gpu_ffn), OpenCL on the phone's Adreno; bit-exact to ggml-cpu's ARM path (M3).
+//            Not wired yet.
+// Coherence contract (the only protocol verified on the phone): a slot is written only between map_write() and
+// unmap(), and dispatch() never reads a slot that is mapped.
+#pragma once
+
+#include "ggml.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace bmoe {
+
+struct GpuTierShape {
+    int n_embd = 0;          // expert input / down output width
+    int n_ff = 0;            // expert hidden width
+    size_t slice_bytes[3];   // largest gate, up, down slice across layers (slots are sized for the largest)
+};
+
+class GpuExpertsBackend {
+public:
+    virtual ~GpuExpertsBackend() = default;
+    virtual const char * name() const = 0;
+    // Allocate up to `max_slots` slots; returns how many were actually allocated (0 = unusable).
+    virtual int init(const GpuTierShape & shape, int max_slots) = 0;
+    // Projection p's slice of slot s, writable. p: 0 gate, 1 up, 2 down.
+    virtual void * map_write(int slot, int p) = 0;
+    virtual void unmap(int slot, int p) = 0;
+    // Start computing k experts' FFNs: slots[i] holds expert i's weights, of the given ggml types; x is the fp32
+    // input row (n_embd), shared by all k; out receives k rows of n_embd floats. Returns false if it cannot start.
+    virtual bool dispatch(int layer, ggml_type t_gate, ggml_type t_up, ggml_type t_down, int k, const int * slots,
+                          const float * x, float * out) = 0;
+    // Block until the last dispatch has completed. Returns false if it failed (out is then undefined).
+    virtual bool wait() = 0;
+};
+
+std::unique_ptr<GpuExpertsBackend> make_gpu_backend_standin();
+
+} // namespace bmoe
--- /dev/null
+++ b/core/src/moe/gpu_tier.cpp
@@ -0,0 +1,165 @@
+// gpu_tier.cpp — moe-phone (patch 0019): the CPU stand-in backend for the GPU expert tier. See gpu_tier.h.
+//
+// Bit-identity argument (checked end to end by the engine's text-identity acceptance, design §12):
+//   - gate/up/down rows: ggml-cpu's MUL_MAT_ID computes each output row as ONE vec_dot call (nrc = 1) of the
+//     weight row against the activation row quantized by from_float into the type's vec_dot_type
+//     (ggml-cpu.c, ggml_compute_forward_mul_mat_id_one_chunk). The same calls are made here, with the same
+//     quantization of the same fp32 input. The M1 test (host/test_mmid_split.cpp) showed this reproduces
+//     MUL_MAT_ID's rows bit for bit.
+//   - SwiGLU: the graph computes ggml_swiglu_split(gate, up) row by row; the same op, on one row, is run here
+//     through a one-op ggml graph, so the element function is ggml's own.
+//   - down: its input row (the SwiGLU output) is quantized into the down type's vec_dot_type exactly as
+//     MUL_MAT_ID quantizes src1 per slot, then one vec_dot per output row.
+// Nothing here calls MUL_MAT_ID, so the split hooks never recurse.
+#include "gpu_tier.h"
+
+#include "ggml-cpu.h"
+
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <thread>
+
+namespace bmoe {
+namespace {
+
+class StandinBackend final : public GpuExpertsBackend {
+public:
+    ~StandinBackend() override {
+        {
+            std::lock_guard<std::mutex> lk(mtx_);
+            stop_ = true;
+        }
+        cv_.notify_all();
+        if (worker_.joinable()) worker_.join();
+        for (void * p : slots_) std::free(p);
+        if (gctx_) ggml_free(gctx_);
+    }
+    const char * name() const override { return "standin"; }
+
+    int init(const GpuTierShape & shape, int max_slots) override {
+        shape_ = shape;
+        slot_bytes_ = 0;
+        for (int p = 0; p < 3; ++p) {
+            off_[p] = slot_bytes_;
+            slot_bytes_ += (shape.slice_bytes[p] + 4095) & ~(size_t) 4095;
+        }
+        for (int s = 0; s < max_slots; ++s) {
+            void * m = nullptr;
+            if (posix_memalign(&m, 4096, slot_bytes_) != 0 || !m) break;
+            slots_.push_back(m);
+        }
+        // one-op SwiGLU graph over a single row, reused for every expert
+        ggml_init_params ip = { (size_t) 4 * 1024 * 1024, nullptr, false };
+        gctx_ = ggml_init(ip);
+        if (!gctx_) return 0;
+        g_ = ggml_new_tensor_1d(gctx_, GGML_TYPE_F32, shape.n_ff);
+        u_ = ggml_new_tensor_1d(gctx_, GGML_TYPE_F32, shape.n_ff);
+        h_ = ggml_swiglu_split(gctx_, g_, u_);
+        gf_ = ggml_new_graph(gctx_);
+        ggml_build_forward_expand(gf_, h_);
+        worker_ = std::thread([this] { run(); });
+        return (int) slots_.size();
+    }
+
+    void * map_write(int slot, int p) override { return (char *) slots_[(size_t) slot] + off_[p]; }
+    void unmap(int, int) override {}
+
+    bool dispatch(int layer, ggml_type tg, ggml_type tu, ggml_type td, int k, const int * slots, const float * x,
+                  float * out) override {
+        std::lock_guard<std::mutex> lk(mtx_);
+        if (busy_) return false; // one dispatch in flight at a time
+        job_.layer = layer;
+        job_.t[0] = tg; job_.t[1] = tu; job_.t[2] = td;
+        job_.slots.assign(slots, slots + k);
+        job_.x.assign(x, x + shape_.n_embd);
+        job_.out = out;
+        job_.ok = true;
+        busy_ = true;
+        cv_.notify_all();
+        return true;
+    }
+
+    bool wait() override {
+        std::unique_lock<std::mutex> lk(mtx_);
+        done_cv_.wait(lk, [&] { return !busy_; });
+        return job_.ok;
+    }
+
+private:
+    struct Job {
+        int layer = -1;
+        ggml_type t[3];
+        std::vector<int> slots;
+        std::vector<float> x;
+        float * out = nullptr;
+        bool ok = true;
+    };
+
+    // rows[r] = vec_dot(weight row r, quantized input) for r in [0, n_rows): what MUL_MAT_ID's one_chunk computes.
+    static void rows_dot(ggml_type wt, const void * w, int64_t n_in, int64_t n_rows, const float * in, float * out,
+                         std::vector<char> & q) {
+        const auto * tr = ggml_get_type_traits_cpu(wt);
+        const ggml_type vt = tr->vec_dot_type;
+        const auto * trv = ggml_get_type_traits_cpu(vt);
+        const size_t row_bytes = ggml_row_size(wt, n_in);
+        const void * y = in;
+        if (vt != GGML_TYPE_F32) {
+            q.resize(ggml_row_size(vt, n_in));
+            trv->from_float(in, q.data(), n_in);
+            y = q.data();
+        }
+        for (int64_t r = 0; r < n_rows; ++r)
+            tr->vec_dot((int) n_in, &out[r], 0, (const char *) w + (size_t) r * row_bytes, 0, y, 0, 1);
+    }
+
+    void run() {
+        std::vector<char> q;
+        std::vector<float> gate((size_t) shape_.n_ff), up((size_t) shape_.n_ff);
+        for (;;) {
+            {
+                std::unique_lock<std::mutex> lk(mtx_);
+                cv_.wait(lk, [&] { return stop_ || (busy_ && !running_); });
+                if (stop_) return;
+                running_ = true;
+            }
+            const int n_embd = shape_.n_embd, n_ff = shape_.n_ff;
+            for (size_t i = 0; i < job_.slots.size(); ++i) {
+                const char * base = (const char *) slots_[(size_t) job_.slots[i]];
+                rows_dot(job_.t[0], base + off_[0], n_embd, n_ff, job_.x.data(), gate.data(), q);
+                rows_dot(job_.t[1], base + off_[1], n_embd, n_ff, job_.x.data(), up.data(), q);
+                std::memcpy(g_->data, gate.data(), (size_t) n_ff * sizeof(float));
+                std::memcpy(u_->data, up.data(), (size_t) n_ff * sizeof(float));
+                if (ggml_graph_compute_with_ctx(gctx_, gf_, 1) != GGML_STATUS_SUCCESS) { job_.ok = false; break; }
+                rows_dot(job_.t[2], base + off_[2], n_ff, n_embd, (const float *) h_->data, job_.out + i * (size_t) n_embd, q);
+            }
+            {
+                std::lock_guard<std::mutex> lk(mtx_);
+                running_ = false;
+                busy_ = false;
+            }
+            done_cv_.notify_all();
+        }
+    }
+
+    GpuTierShape shape_;
+    size_t off_[3] = {0, 0, 0};
+    size_t slot_bytes_ = 0;
+    std::vector<void *> slots_;
+    ggml_context * gctx_ = nullptr;
+    ggml_tensor * g_ = nullptr, * u_ = nullptr, * h_ = nullptr;
+    ggml_cgraph * gf_ = nullptr;
+    std::mutex mtx_;
+    std::condition_variable cv_, done_cv_;
+    bool stop_ = false, busy_ = false, running_ = false;
+    Job job_;
+    std::thread worker_;
+};
+
+} // namespace
+
+std::unique_ptr<GpuExpertsBackend> make_gpu_backend_standin() { return std::make_unique<StandinBackend>(); }
+
+} // namespace bmoe
