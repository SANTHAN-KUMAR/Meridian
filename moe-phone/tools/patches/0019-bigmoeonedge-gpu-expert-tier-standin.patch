+// ── moe-phone 0019: the GPU expert tier (gpu_tier.h; research/2026-09-18_gpu_expert_path_design.md §12) ──────
+bool ExpertStreamSource::gtier_init(const MoeStreamConfig & cfg) {
+    if (cache_max_ == 0 || arena_ || recycle_pages_ || defer_evict_ || !overlap_) {
+        std::fprintf(stderr, "bmoe: gpu-tier needs the plain LRU/SLRU cache with --overlap (not shared-slot, --slot-arena, "
+                             "--recycle-pages or --defer-evict)\n");
+        return false;
+    }
+    GpuTierShape sh{};
+    for (int p = 0; p < 3; ++p) sh.slice_bytes[p] = 0;
+    for (const LayerExperts & L : layers_) {
+        if (!L.bound) continue;
+        // separate gate, up, down, as llama.cpp's build_moe_ffn computes them (up, gate, swiglu_split, down); a fused
+        // gate_up layout or a missing projection is a different graph the device does not implement
+        for (int p = 0; p < 3; ++p)
+            if (!L.proj[p].tensor || !L.proj[p].nb2) {
+                std::fprintf(stderr, "bmoe: gpu-tier: layer without separate gate/up/down experts; unsupported\n");
+                return false;
+            }
+        const ggml_tensor * g = L.proj[0].tensor;
+        const ggml_tensor * d = L.proj[2].tensor;
+        if (sh.n_embd == 0) { sh.n_embd = (int) g->ne[0]; sh.n_ff = (int) g->ne[1]; }
+        if (g->ne[0] != sh.n_embd || g->ne[1] != sh.n_ff || d->ne[0] != sh.n_ff || d->ne[1] != sh.n_embd) {
+            std::fprintf(stderr, "bmoe: gpu-tier: expert shapes differ across layers; unsupported\n");
+            return false;
+        }
+        for (int p = 0; p < 3; ++p) sh.slice_bytes[p] = std::max<size_t>(sh.slice_bytes[p], (size_t) L.proj[p].nb2);
+    }
+    size_t slot_bytes = 0;
+    for (int p = 0; p < 3; ++p) slot_bytes += (sh.slice_bytes[p] + 4095) & ~(size_t) 4095;
+    const int want = (int) (((size_t) cfg.gpu_tier_mb << 20) / slot_bytes);
+    if (want <= 0) return false;
+    if (std::string(cfg.gpu_backend ? cfg.gpu_backend : "") != "standin") {
+        std::fprintf(stderr, "bmoe: gpu-tier: backend '%s' not available in this build\n", cfg.gpu_backend);
+        return false;
+    }
+    gpu_ = make_gpu_backend_standin();
+    const int n = gpu_->init(sh, want);
+    if (n <= 0) return false;
+    // the tier's memory comes OUT of the CPU cache budget, so the run's total stays what the budget allowed
+    const size_t take = std::min(cache_max_ / 2, (size_t) n * slot_bytes);
+    gt_cpu_budget_taken_ = take;
+    cache_max_ -= take;
+    const size_t n_entry = (size_t) n_layer_ * (size_t) n_expert_;
+    gslot_of_.assign(n_entry, -1);
+    ghits_.assign(n_entry, 0);
+    gowner_.assign((size_t) n, -1);
+    gprev_.assign((size_t) n, -1);
+    gnext_.assign((size_t) n, -1);
+    gfree_.clear();
+    for (int i = n - 1; i >= 0; --i) gfree_.push_back(i);
+    gpromote_hits_ = std::max(1, cfg.gpu_promote_hits);
+    gtier_on_ = true;
+    std::fprintf(stderr, "bmoe: gpu-tier: backend %s, %d slots x %zu KiB (n_embd %d, n_ff %d), promote after %d hits, "
+                         "CPU cache budget now %zu MiB\n", gpu_->name(), n, slot_bytes >> 10, sh.n_embd, sh.n_ff,
+                 gpromote_hits_, cache_max_ >> 20);
+    return true;
+}
+
+void ExpertStreamSource::gtier_touch(int32_t s) {
+    if (ghead_ == s) return;
+    // unlink
+    if (gprev_[s] != -1) gnext_[gprev_[s]] = gnext_[s]; else if (ghead_ == s) ghead_ = gnext_[s];
+    if (gnext_[s] != -1) gprev_[gnext_[s]] = gprev_[s]; else if (gtail_ == s) gtail_ = gprev_[s];
+    // push front
+    gprev_[s] = -1;
+    gnext_[s] = ghead_;
+    if (ghead_ != -1) gprev_[ghead_] = s;
+    ghead_ = s;
+    if (gtail_ == -1) gtail_ = s;
+}
+
+void ExpertStreamSource::gtier_evict_tail() {
+    const int32_t s = gtail_;
+    if (s < 0) return;
+    const int32_t id = gowner_[s];
+    gtail_ = gprev_[s];
+    if (gtail_ != -1) gnext_[gtail_] = -1; else ghead_ = -1;
+    gprev_[s] = gnext_[s] = -1;
+    gowner_[s] = -1;
+    if (id >= 0) { gslot_of_[id] = -1; ghits_[id] = 0; }
+    gfree_.push_back(s);
+    ++gt_evictions_;
+}
+
+void ExpertStreamSource::gtier_flush() {
+    while (gtail_ != -1) gtier_evict_tail();
+    ++gt_flushes_;
+}
+
+void ExpertStreamSource::gtier_release_cpu(int32_t id) {
+    // evict_tail's bookkeeping for one chosen entry, without counting an eviction (the expert is moving tiers)
+    lru_unlink(id); // before cprot_ changes: it picks the list from cprot_
+    const int il = id / n_expert_;
+    if (slru_ && !cprot_.empty() && cprot_[id]) {
+        cprot_bytes_ -= entry_bytes(il);
+        cprot_[id] = 0;
+    }
+    release_entry_pages(id);
+    cvalid_[id] = 0;
+    cspec_[id] = 0;
+    cresident_ -= entry_bytes(il);
+}
+
+bool ExpertStreamSource::gtier_promote(int32_t id) {
+    if (gfree_.empty()) gtier_evict_tail();
+    if (gfree_.empty()) return false;
+    const int32_t s = gfree_.back();
+    gfree_.pop_back();
+    const int il = id / n_expert_, e = id % n_expert_;
+    const LayerExperts & L = layers_[il];
+    for (int p = 0; p < 3; ++p) {
+        const uint64_t slice = L.proj[p].nb2;
+        void * dst = gpu_->map_write(s, p);
+        std::memcpy(dst, (const char *) lbuf_[p][il] + (uint64_t) e * slice, slice);
+        gpu_->unmap(s, p);
+    }
+    gtier_release_cpu(id);
+    gslot_of_[id] = s;
+    gowner_[s] = id;
+    gprev_[s] = -1;
+    gnext_[s] = ghead_;
+    if (ghead_ != -1) gprev_[ghead_] = s;
+    ghead_ = s;
+    if (gtail_ == -1) gtail_ = s;
+    ++gt_promotions_;
+    return true;
+}
