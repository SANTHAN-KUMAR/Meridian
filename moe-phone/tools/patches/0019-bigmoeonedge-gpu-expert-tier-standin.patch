+bool ExpertStreamSource::c_mmid_begin(const ggml_tensor * dst, unsigned char * skip, int n_as, void * ud) {
+    return static_cast<ExpertStreamSource *>(ud)->on_mmid_begin(dst, skip, n_as);
+}
+void ExpertStreamSource::c_mmid_end(const ggml_tensor * dst, void * ud) {
+    static_cast<ExpertStreamSource *>(ud)->on_mmid_end(dst);
+}
