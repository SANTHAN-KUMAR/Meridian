+// Thread 0, once per MUL_MAT_ID, before the op's barrier (ggml-cpu split hooks, patch 0017).
+bool ExpertStreamSource::on_mmid_begin(const ggml_tensor * dst, unsigned char * skip, int n_as) {
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    const ggml_tensor * ids = dst->src[2];
+    auto it = std::lower_bound(texp_.begin(), texp_.end(), (const void *) src0,
+                               [](const std::pair<const void *, uint32_t> & a, const void * k) { return a.first < k; });
+    if (it == texp_.end() || it->first != (const void *) src0) return false;
+    const int il = (int) (it->second >> 8);
+    const int p = (int) (it->second & 0xff);
+    if (dst->ne[2] != 1 || cur_nt_ != 1) return false; // decode only
+    const int nu = (int) ids->ne[0];
+    std::vector<int> pos, slots;
+    for (int s = 0; s < nu; ++s) {
+        const int e = *(const int32_t *) ((const char *) ids->data + (size_t) s * ids->nb[0]);
+        if (e < 0 || e >= n_as || e >= n_expert_) continue;
+        const int32_t slot = gslot_of_[(size_t) il * (size_t) n_expert_ + (size_t) e];
+        if (slot < 0) continue;
+        skip[e] = 1;
+        pos.push_back(s);
+        slots.push_back(slot);
+    }
+    if (pos.empty()) return false;
+    for (int s : pos) std::memset((char *) dst->data + (size_t) s * dst->nb[1], 0, (size_t) dst->ne[0] * sizeof(float));
+    if (gdispatch_seq_ != gload_seq_) {
+        // first expert matmul of this layer (up, in llama.cpp's graph): its src1 is the layer's fp32 input row
+        if (p == 2 || src1->type != GGML_TYPE_F32 || src1->ne[0] != layers_[il].proj[0].tensor->ne[0]) {
+            std::fprintf(stderr, "bmoe: gpu-tier FATAL: first expert op of layer %d is proj %d with an unexpected input\n", il, p);
+            std::abort();
+        }
+        gdisp_slotpos_ = pos;
+        gdisp_slots_ = slots;
+        gdispatch_layer_ = il;
+        gout_.resize((size_t) slots.size() * (size_t) src1->ne[0]);
+        const LayerExperts & L = layers_[il];
+        if (!gpu_->dispatch(il, L.proj[0].tensor->type, L.proj[1].tensor->type, L.proj[2].tensor->type,
+                            (int) slots.size(), slots.data(), (const float *) src1->data, gout_.data())) {
+            ++gt_fail_;
+            std::fprintf(stderr, "bmoe: gpu-tier FATAL: dispatch failed at layer %d (the CPU copies are released)\n", il);
+            std::abort();
+        }
+        gdispatch_seq_ = gload_seq_;
+        ++gt_dispatches_;
+        gt_experts_ += (long long) slots.size();
+    } else if (pos != gdisp_slotpos_ || il != gdispatch_layer_) {
+        std::fprintf(stderr, "bmoe: gpu-tier FATAL: layer %d proj %d selects a different GPU set than its dispatch\n", il, p);
+        std::abort();
+    }
+    return true;
+}
+
+// Thread 0, after its own share of the op; only called if begin returned true.
+void ExpertStreamSource::on_mmid_end(const ggml_tensor * dst) {
+    const ggml_tensor * src0 = dst->src[0];
+    auto it = std::lower_bound(texp_.begin(), texp_.end(), (const void *) src0,
+                               [](const std::pair<const void *, uint32_t> & a, const void * k) { return a.first < k; });
+    if (it == texp_.end() || it->first != (const void *) src0) return;
+    const int p = (int) (it->second & 0xff);
+    if (p != 2) return; // gate/up: the device's result arrives with down
+    const auto t0 = clock_t_::now();
+    if (!gpu_->wait()) {
+        ++gt_fail_;
+        std::fprintf(stderr, "bmoe: gpu-tier FATAL: device reported failure at layer %d\n", gdispatch_layer_);
+        std::abort();
+    }
+    gt_wait_ns_ += (long long) std::chrono::duration_cast<std::chrono::nanoseconds>(clock_t_::now() - t0).count();
+    const size_t n_embd = (size_t) dst->ne[0];
+    for (size_t i = 0; i < gdisp_slotpos_.size(); ++i)
+        std::memcpy((char *) dst->data + (size_t) gdisp_slotpos_[i] * dst->nb[1], gout_.data() + i * n_embd, n_embd * sizeof(float));
+}
